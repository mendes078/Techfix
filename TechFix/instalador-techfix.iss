; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

[Setup]

#define MyAppName "TechFix"
#define MyAppVersion "1.0.0"
#define MyAppPublisher "TechFix"
#define MyAppExeName "TechFix.exe"

[Setup]

AppId={{A7B51C29-6D43-4A82-9F12-8B67D5C43120}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}

DefaultDirName={localappdata}\Programs\TechFix
DefaultGroupName=TechFix

DisableProgramGroupPage=yes
PrivilegesRequired=lowest

OutputDir=.
OutputBaseFilename=TechFix-Setup

Compression=lzma
SolidCompression=yes
WizardStyle=modern

Uninstallable=yes

[Languages]
Name: "brazilianportuguese"; MessagesFile: "compiler:Languages\BrazilianPortuguese.isl"

[Tasks]
Name: "desktopicon"; Description: "Criar atalho na área de trabalho"; GroupDescription: "Atalhos adicionais:"; Flags: unchecked

[Files]
Source: "C:\Users\Pichau\Documents\GitHub\Techfix\TechFix\dist\TechFix\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{group}\TechFix"; Filename: "{app}\TechFix.exe"
Name: "{autodesktop}\TechFix"; Filename: "{app}\TechFix.exe"; Tasks: desktopicon

[Run]
Filename: "{app}\TechFix.exe"; Description: "Abrir TechFix"; Flags: postinstall nowait skipifsilent
